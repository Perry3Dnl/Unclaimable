<Project>
  <PropertyGroup>
    <UnclaimableVersion>0.8.4</UnclaimableVersion>

    <Authors>Perry3D.nl</Authors>
    <Copyright>Copyright (c) 2026 Perry3D.nl</Copyright>
    <RepositoryUrl>https://github.com/Perry3Dnl/Unclaimable</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Perry3Dnl/Unclaimable</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
  </ItemGroup>
</Project>
