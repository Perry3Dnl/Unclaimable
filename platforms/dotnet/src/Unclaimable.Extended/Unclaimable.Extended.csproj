<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);1591</WarningsAsErrors>

    <PackageId>Unclaimable.Extended</PackageId>
    <Version>$(UnclaimableVersion)</Version>
    <Description>Large optional identity datasets for Unclaimable, including organizations, brands, education, sports, transport, public figures, entertainment, and geography.</Description>
    <PackageReadmeFile>README.NUGET.md</PackageReadmeFile>
    <PackageIcon>unclaimable-icon.png</PackageIcon>
    <PackageTags>username;validation;security;reserved-names;datasets;brands;organizations</PackageTags>

    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Unclaimable/Unclaimable.csproj" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../../../data/extended/**/reserved.json"
                      LogicalName="Unclaimable.Extended.Data.%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../../../README.NUGET.md" Pack="true" PackagePath="/" />
    <None Include="../../../../THIRD_PARTY_DATA.md" Pack="true" PackagePath="/" />
    <None Include="../../../../assets/unclaimable-icon.png" Pack="true" PackagePath="/" Link="unclaimable-icon.png" />
  </ItemGroup>

</Project>
