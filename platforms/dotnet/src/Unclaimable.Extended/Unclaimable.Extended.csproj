<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);1591</WarningsAsErrors>
    <PackageId>Unclaimable.Extended</PackageId>
    <Version>$(UnclaimableVersion)</Version>
    <Description>Cross-platform optional reserved-identity datasets for Unclaimable, including brands, companies, education, sports, public figures, transport, and organizations.</Description>
    <PackageReadmeFile>README.NUGET.md</PackageReadmeFile>
    <PackageIcon>unclaimable-icon.png</PackageIcon>
    <PackageTags>username;username-validation;reserved-names;reserved-words;blocked-names;reserved-identity;identity-protection;impersonation;datasets;wordlist;blocklist;brands;brand-protection;companies;organizations;education;sports;public-figures;transport;government;profanity;profanity-filter;multilingual;content-moderation;moderation;validation;security;dotnet;netstandard;cross-platform</PackageTags>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.8.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Unclaimable/Unclaimable.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data/*.json" LogicalName="Unclaimable.Extended.Data.%(Filename)%(Extension)" />
    <None Include="README.NUGET.md" Pack="true" PackagePath="/" />
    <None Include="../../../../assets/unclaimable-icon.png" Pack="true" PackagePath="/" Link="unclaimable-icon.png" />
    <None Include="Data/SOURCES.md" Pack="true" PackagePath="data/" />
    <None Include="Data/THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="data/" />
  </ItemGroup>
</Project>
