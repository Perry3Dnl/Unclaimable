<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);1591</WarningsAsErrors>

    <PackageId>Unclaimable.AspNetCore</PackageId>
    <Version>$(UnclaimableVersion)</Version>
    <Description>ASP.NET Core dependency injection and DataAnnotations integration for Unclaimable, with explicit .NET 6 through .NET 11 framework assets.</Description>
    <PackageReadmeFile>README.NUGET.md</PackageReadmeFile>
    <PackageIcon>unclaimable-icon.png</PackageIcon>
    <PackageTags>aspnetcore;aspnet-core;username;username-validation;username-validator;identifier-validation;reserved-names;reserved-words;profanity-filter;impersonation;identity-protection;validation;model-validation;dataannotations;data-annotations;dependency-injection;di;web-api;web;blazor;server;security;dotnet</PackageTags>

    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.8.5</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Unclaimable/Unclaimable.csproj" />
    <None Include="README.NUGET.md" Pack="true" PackagePath="/" />
    <None Include="../../../../assets/unclaimable-icon.png" Pack="true" PackagePath="/" Link="unclaimable-icon.png" />
  </ItemGroup>

</Project>
