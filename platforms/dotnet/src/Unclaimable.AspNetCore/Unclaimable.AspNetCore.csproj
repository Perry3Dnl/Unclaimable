<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <PackageId>Unclaimable.AspNetCore</PackageId>
    <Version>0.1.0</Version>
    <Authors>ImtehQ</Authors>
    <Copyright>Copyright (c) 2026 Perry3D.nl</Copyright>
    <Description>ASP.NET Core dependency injection and model validation integration for Unclaimable.</Description>
    <RepositoryUrl>https://github.com/ImtehQ/Unclaimable</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ImtehQ/Unclaimable</PackageProjectUrl>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>unclaimable-icon.png</PackageIcon>
    <PackageTags>username;validation;security;aspnetcore;reserved-names</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Unclaimable/Unclaimable.csproj" />
    <None Include="../../../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../../../assets/unclaimable-icon.png" Pack="true" PackagePath="/" Link="unclaimable-icon.png" />
  </ItemGroup>

</Project>
