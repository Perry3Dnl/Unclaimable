<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);1591</WarningsAsErrors>

    <PackageId>Unclaimable</PackageId>
    <Version>$(UnclaimableVersion)</Version>
    <Description>Cross-platform .NET username, identifier, reserved-name, impersonation, and moderation validation for .NET MAUI, Blazor, desktop, server, and worker applications.</Description>
    <PackageReadmeFile>README.NUGET.md</PackageReadmeFile>
    <PackageIcon>unclaimable-icon.png</PackageIcon>
    <PackageTags>username;username-validation;username-validator;username-filter;identifier;identifier-validation;name-validation;reserved-names;reserved-words;blocked-names;profanity;profanity-filter;profanity-detection;multilingual;content-moderation;moderation;impersonation;identity-protection;spoofing;unicode;unicode-normalization;homoglyph;confusables;obfuscation;leetspeak;security;validation;dotnet;netstandard;cross-platform;maui;blazor;webassembly;wpf;winforms;console;worker-service;avalonia;uno</PackageTags>

    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.8.5</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Unclaimable.Email</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../../../data/**/reserved.json" LogicalName="Unclaimable.Data.%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="README.NUGET.md" Pack="true" PackagePath="/" />
    <None Include="../../../../assets/unclaimable-icon.png" Pack="true" PackagePath="/" Link="unclaimable-icon.png" />
  </ItemGroup>

</Project>
