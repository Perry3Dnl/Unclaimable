<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <PackageId>Unclaimable</PackageId>
    <Version>0.1.0</Version>
    <Authors>ImtehQ</Authors>
    <Description>Fast, dependency-free reserved username detection backed by the shared Unclaimable datasets.</Description>
    <RepositoryUrl>https://github.com/ImtehQ/Unclaimable</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../../../data/**/*.json" LogicalName="Unclaimable.Data.%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../../../README.md" Pack="true" PackagePath="/" Link="README.md" />
  </ItemGroup>

</Project>
