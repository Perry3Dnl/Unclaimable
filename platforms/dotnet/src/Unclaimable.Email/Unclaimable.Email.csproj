<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);1591</WarningsAsErrors>

    <PackageId>Unclaimable.Email</PackageId>
    <Version>$(UnclaimableVersion)</Version>
    <Description>Cross-platform .NET email identity, protected-domain, impersonation, phishing, and lookalike validation for MAUI, Blazor, desktop, server, and worker applications.</Description>
    <PackageReadmeFile>README.NUGET.md</PackageReadmeFile>
    <PackageIcon>unclaimable-icon.png</PackageIcon>
    <PackageTags>email;email-validation;email-validator;email-security;email-identity;email-protection;domain;domain-validation;protected-domain;protected-domains;domain-protection;domain-lookalike;lookalike-domain;phishing;phishing-protection;impersonation;identity-protection;spoofing;homoglyph;confusables;unicode;idn;internationalized-domain;public-suffix;security;validation;dotnet;netstandard;cross-platform;maui;blazor</PackageTags>

    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.8.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="public_suffix_list.dat" LogicalName="Unclaimable.Email.public_suffix_list.dat" />
    <None Include="public_suffix_list.dat" Pack="true" PackagePath="third-party/" />
    <None Include="PSL-LICENSE.txt" Pack="true" PackagePath="third-party/" />
    <ProjectReference Include="../Unclaimable/Unclaimable.csproj" />
    <None Include="README.NUGET.md" Pack="true" PackagePath="/" />
    <None Include="../../../../assets/unclaimable-icon.png" Pack="true" PackagePath="/" Link="unclaimable-icon.png" />
  </ItemGroup>

</Project>
