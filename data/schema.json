{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Perry3Dnl/Unclaimable/data/schema.json",
  "title": "Unclaimable reserved-name list",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "category", "description"],
  "anyOf": [
    { "required": ["values"] },
    { "required": ["partialValues"] },
    { "required": ["combinations"] }
  ],
  "properties": {
    "schema": {
      "enum": [1, 2]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "description": "ISO-style language code for localized data, or 'global' for language-independent data. Omitted legacy datasets are treated as English except brands and technology, which are global.",
      "pattern": "^(global|[a-z]{2,3})$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "values": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "partialValues": {
      "type": "array",
      "description": "Schema-v2 values that remain exact reserved names and are also explicitly safe to match inside larger identifiers.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "combinations": {
      "type": "array",
      "description": "Schema-v2 value families. Every root is concatenated with every suffix to create concrete reserved-name entries.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roots", "suffixes"],
        "properties": {
          "roots": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "suffixes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "partial": {
            "type": "boolean",
            "default": false,
            "description": "When true, expanded values are explicitly safe for partial matching."
          }
        }
      }
    }
  }
}
